{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcglobal.ai/bela-pesca/archive/schemas/archive.schema.json",
  "title": "Bela Pesca Digital - Archive Manifest Contract",
  "description": "Contrato canônico do manifesto de arquivamento de uma edição preservada.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domain",
    "editionId",
    "archiveVersion",
    "archivedAt",
    "archivedBy",
    "finalState",
    "contracts",
    "evidenceRefs",
    "provenanceRefs",
    "integrityRefs",
    "closureRefs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "domain": {
      "type": "string",
      "const": "ARCHIVE"
    },
    "editionId": {
      "type": "string",
      "minLength": 1
    },
    "archiveVersion": {
      "type": "string",
      "minLength": 1
    },
    "archivedAt": {
      "type": "string",
      "format": "date-time"
    },
    "archivedBy": {
      "type": "string",
      "minLength": 1
    },
    "finalState": {
      "type": "string",
      "const": "ARCHIVED"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenanceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "integrityRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "closureRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
