{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcglobal.ai/bela-pesca/schemas/location.schema.json",
  "title": "Bela Pesca Digital — Location Contract",
  "description": "Contrato canônico dos locais utilizados por uma edição do Bela Pesca Digital.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domain",
    "editionId",
    "locations"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "domain": {
      "type": "string",
      "const": "LOCATION"
    },
    "editionId": {
      "type": "string",
      "minLength": 1
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "coordinatesVerified"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "latitude": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "coordinatesVerified": {
            "type": "boolean"
          },
          "privateResidence": {
            "type": "boolean"
          },
          "exactPinAuthorized": {
            "type": "boolean"
          },
          "googleMapsQuery": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "receivedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "documentId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
